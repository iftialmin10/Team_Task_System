DATABASE_URL="postgresql://USER:PASSWORD@POOLER_HOST/DATABASE?sslmode=verify-full"
DATABASE_POOL_MAX=10
DATABASE_CONNECT_TIMEOUT_MS=10000
DATABASE_IDLE_TIMEOUT_MS=30000
PORT=4000
CORS_ORIGIN="http://localhost:5173"
# Optional for split frontend/API deployments. Same-origin /api is the default.
# VITE_API_URL="https://api.example.com/api"
